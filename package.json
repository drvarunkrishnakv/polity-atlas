{
  "name": "polity-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web -- --host 0.0.0.0 --port 4173",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "vitest run",
    "check": "npm run format:check && node tooling/build-study-navigation.mjs --check && npm run typecheck && npm run test && npm run build && npm run audit:public",
    "test:e2e": "playwright test",
    "audit:public": "node tooling/audit-public.mjs",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css,json}\" \"tests/**/*.ts\" \"tooling/*.mjs\" \"*.config.ts\"",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css,json}\" \"tests/**/*.ts\" \"tooling/*.mjs\" \"*.config.ts\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
